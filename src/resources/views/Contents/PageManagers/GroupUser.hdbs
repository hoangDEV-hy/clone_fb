<div class="page-manager-container">
    <div class="page-manager-header">
        <h1>📋 Quản lý nhóm</h1>
        <p>Xem và quản lý các nhóm bạn đã tham gia hoặc đang chờ duyệt</p>
    </div>

    <div class="page-manager-sidebar">
        <a href="/page_manager/group_user/joined" class="sidebar-nav-link {{#if (eq currentPage 'joined')}}active{{/if}}">
            ✅ Nhóm đã tham gia
        </a>
        <a href="/page_manager/group_user/pending" class="sidebar-nav-link {{#if (eq currentPage 'pending')}}active{{/if}}">
            ⏳ Nhóm chờ duyệt
        </a>
        <button type="button" id="create-group-btn" class="btn-primary">
            ➕ Tạo nhóm mới
        </button>
    </div>

    <div class="groups-list">
        {{#if group.length}}
        {{#each group}}
        <div class="manager-card group-card" data-group-id="{{this.id}}">
            <div class="card-header">
                <img src="{{this.avatar}}" alt="{{this.name}}" class="card-avatar" onerror="this.src='/pictures/avatar.jpg'">
                <div class="card-title">{{this.name}}</div>
                <div class="card-actions">
                    <button type="button" class="toggle-more-btn btn-more">Thêm</button>
                </div>
            </div>

            {{#if this.hastag}}
            <p style="color: #65676b; font-size: 14px; margin-bottom: 12px;">#{{this.hastag}}</p>
            {{/if}}

            <div class="more-actions hidden">
                <form action="/group" method="POST" style="display:inline;">
                    <input type="hidden" name="groupId" value="{{this.id}}">
                    <button type="submit" class="btn-primary">🔗 Truy cập nhóm</button>
                </form>

                {{#if this.isPending}}
                <button type="button" class="cancel-request-btn btn-secondary">❌ Hủy yêu cầu</button>
                {{else}}
                <button type="button" class="leave-group-btn btn-danger">🚪 Rời nhóm</button>
                {{/if}}
            </div>
        </div>
        {{/each}}
        {{else}}
        <div class="empty-state">
            <p>Không có nhóm nào</p>
        </div>
        {{/if}}
    </div>
</div>

<!-- Modal tạo nhóm -->
<div id="create-group-modal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2>➕ Tạo nhóm mới</h2>
        </div>
        <form id="create-group-form">
            <div class="modal-form-group">
                <label for="group-name">Tên nhóm *</label>
                <input type="text" id="group-name" required placeholder="Nhập tên nhóm">
            </div>
            <div class="modal-form-group">
                <label for="group-hashtag">Hashtag (tùy chọn)</label>
                <input type="text" id="group-hashtag" placeholder="Nhập hashtag">
            </div>
            <div class="modal-actions">
                <button type="button" id="cancel-create-btn" class="btn-secondary">Hủy</button>
                <button type="submit" class="btn-primary">Tạo nhóm</button>
            </div>
        </form>
    </div>
</div>

<link rel="stylesheet" href="/css/contens/page-manager.css">
<script src="/js/group-user-page.js"></script>