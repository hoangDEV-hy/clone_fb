<div class="page-manager-container">
    <div class="page-manager-header">
        <h1>👥 Danh sách người theo dõi</h1>
        <p>Quản lý danh sách những người đang theo dõi bạn</p>
    </div>

    <div id="error-message" style="display: none;" class="error-message"></div>
    <div id="success-message" style="display: none;" class="success-message"></div>

    <div id="followers-list" class="followers-grid">
        <div class="loading-state">Đang tải...</div>
    </div>

    <div class="pagination" id="pagination-container" style="display: none;">
        <button id="prev-btn" class="btn-secondary" onclick="loadPage(currentPage - 1)">
            ← Trước
        </button>
        <span id="page-info">Trang 1</span>
        <button id="next-btn" class="btn-secondary" onclick="loadPage(currentPage + 1)">
            Sau →
        </button>
    </div>
</div>

<input type="hidden" data-user-id="{{ selectedUserId }}">

<link rel="stylesheet" href="/css/contens/page-manager.css">
<script src="/js/view-following-page.js"></script>

<style>
.followers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
}

.error-message {
    background-color: #fee;
    border: 1px solid #fcc;
    color: #c33;
    padding: 12px 16px;
    border-radius: 10px;
    margin-bottom: 20px;
}

.success-message {
    background-color: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
    padding: 12px 16px;
    border-radius: 10px;
    margin-bottom: 20px;
}

.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
}

.pagination span {
    color: #65676b;
    font-size: 14px;
    font-weight: 500;
}
</style>