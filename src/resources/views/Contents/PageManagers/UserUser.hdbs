<div class="page-manager-container">
    <div class="page-manager-header">
        <h1>👥 Quản lý bạn bè</h1>
        <p>Xem và quản lý danh sách bạn bè của bạn</p>
    </div>

    <div class="page-manager-sidebar">
        <a href="/page_manager/friends/joined" class="sidebar-nav-link {{#if (eq currentPage 'joined')}}active{{/if}}">
            ✅ Đã kết bạn
        </a>
        <a href="/page_manager/friends/waited" class="sidebar-nav-link {{#if (eq currentPage 'waited')}}active{{/if}}">
            ⏳ Đang chờ duyệt
        </a>
    </div>

    <div class="friends-list">
        {{#if group.length}}
        {{#each group}}
        <div class="manager-card friend-card" data-user-id="{{this.id}}">
            <div class="card-header">
                <img src="{{this.avatar}}" alt="{{this.name}}" class="card-avatar" onerror="this.src='/pictures/avatar.jpg'">
                <div class="card-title">{{this.name}}</div>
                <div class="card-actions">
                    <button type="button" class="toggle-more-btn btn-more">Thêm</button>
                </div>
            </div>

            <div class="more-actions hidden">
                <form action="/page_manager/user" method="POST" style="display:inline;">
                    <input type="hidden" name="selectedTargetId" value="{{this.id}}">
                    <button type="submit" class="btn-primary">👤 Trang cá nhân</button>
                </form>

                {{#if this.isPending}}
                <button type="button" class="accept-friend-btn btn-success">✅ Chấp nhận</button>
                {{/if}}

                <button type="button" class="remove-friend-btn btn-danger">
                    {{#if this.isPending}}❌ Từ chối{{else}}🗑️ Xóa bạn bè{{/if}}
                </button>
            </div>
        </div>
        {{/each}}
        {{else}}
        <div class="empty-state">
            <p>{{#if (eq currentPage 'waited')}}Không có lời mời kết bạn nào{{else}}Không có bạn bè nào{{/if}}</p>
        </div>
        {{/if}}
    </div>
</div>

<link rel="stylesheet" href="/css/contens/page-manager.css">
<script src="/js/user-user-page.js"></script>