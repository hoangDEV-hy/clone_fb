<div class="page-manager-container">
    <div class="page-manager-header">
        <h1>📝 Quản lý bài đăng nhóm</h1>
        <p>{{groups.name}}</p>
        {{#if isAdmin}}
        <div style="margin-top: 12px;">
            <a href="Post/admin/Post" class="btn-secondary">⚙️ Trang quản lý</a>
        </div>
        {{/if}}
    </div>

    <div style="margin-bottom: 24px;">
        <label for="sort-posts" style="font-weight: 600; color: #4a5568; margin-right: 12px;">Sắp xếp:</label>
        <select id="sort-posts" data-role="sort" class="btn-secondary" style="padding: 10px 16px; border-radius: 10px; border: 2px solid #e3f2ff;">
            <option value="">-- Sắp xếp theo --</option>
            <option value="like">⭐ Nhiều lượt thích nhất</option>
            <option value="commend">💬 Nhiều bình luận nhất</option>
            <option value="share">🔄 Nhiều chia sẻ nhất</option>
        </select>
    </div>

    <div class="posts-list">
        {{#each Posts}}
        <div class="news manager-card">
            <input type="hidden" value="{{users.id}}">
            <div class="bd_ct_news_nguoiDang">
                <div class="card-header">
                    <img src="/{{users.avatar}}" alt="{{users.name}}" class="card-avatar" style="width: 48px; height: 48px;">
                    <div style="flex: 1;">
                        <h4 style="font-size: 16px; font-weight: 600; color: #102a43; margin-bottom: 4px;">{{users.name}}</h4>
                        <small style="color: #65676b; font-size: 13px;">{{time updatedAt}}</small>
                    </div>
                    <div class="card-actions">
                        <form action="/page_manager/Post/del?_method=DELETE" method="POST" style="display:inline">
                            <input type="hidden" name="id" value="{{id}}">
                            <button type="submit" class="btn-danger" style="font-size: 12px; padding: 6px 12px;">🗑️ Xóa</button>
                        </form>
                        <form action="/page_manager/Post/update" method="POST" style="display:inline">
                            <input type="hidden" name="id" value="{{id}}">
                            <button type="submit" class="btn-secondary" style="font-size: 12px; padding: 6px 12px;">✏️ Sửa</button>
                        </form>
                    </div>
                </div>

                <div class="bd_ct_news_title" style="margin-top: 16px;">
                    <input type="hidden" value="{{id}}">
                    <h3 style="font-size: 15px; line-height: 1.6; color: #102a43; margin-bottom: 12px;">{{contens.text}}</h3>
                    <input class="image_src" type="hidden" value="{{contens.image}}">
                    <img class="image_src" src="" alt="ảnh news" style="max-width: 100%; border-radius: 12px; margin-top: 8px;">
                </div>

                <div class="bd_ct_news_commend" style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #e3f2ff;">
                    <div id="bd_ct_news_commend_thongKe_news{{id}}">
                        <p id="bd_ct_news_cmd_tk_text_news{{id}}"></p>
                    </div>
                    <div class="bd_ct_news_commend_tuongTac" style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                            <input type="checkbox" class="like-checkbox" id="{{id}}" data-id="{{id}}">
                            <span style="color: #65676b; font-weight: 500;">👍 Thích</span>
                        </label>
                        <button name="commend" data-id="{{id}}" class="btn-secondary" style="font-size: 13px; padding: 6px 12px;">💬 Bình luận</button>
                        <form action="/Post/share" method="POST" style="display:inline">
                            <input type="hidden" name="id_Post" value={{id}}>
                            <button type="submit" class="btn-secondary" style="font-size: 13px; padding: 6px 12px;">🔄 Chia sẻ</button>
                        </form>
                        <div class="bd_ct_news_cmd_tuongTac_pop" style="display:none;">
                            <iframe id="myIframe" src="/Post/iframe/commend" style="width:100%; height:400px; border-radius: 12px;"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

<link rel="stylesheet" href="/css/contens/page-manager.css">
<link rel="stylesheet" href="/css/app.css">
<script type="module" src="/js/post-manager-page.js"></script>
