<form action="">
    <div>
        <div style="display:flex">
            <input type="hidden" id="PostId" value="{{Post.id}}">
            {{!-- for update --}}
            <input type="hidden" id="groupId" value="{{group_id}}{{Post.group_id}}">-
            <input type="hidden" id="userId" value="{{user.id}}{{Post.user_id}}">
            {{#if user.id}}
            <img src="{{user.avatar}}" alt="" style="width:50px;height:50px;border-radius:50%;">
            <h3>{{user.name}}</h3>
            {{/if}}
            {{#if Post.user_id}}
            <img src="{{Post.users.avatar}}" alt="" style="width:50px;height:50px;border-radius:50%;">
            <h3>{{Post.users.name}}</h3>
            {{/if}}
            <select id="scope">
                <option value="">-- Chọn phạm vi truy cập --</option>
                <option value="only_me">only_me</option>
                <option value="public">public</option>
                <option value="group">group</option>
            </select>
        </div>

        <!-- Khung chứa background + textarea -->
        <div style="position: relative; width: 300px; height: 200px;">

            <img name="background" src="" alt=""
                style="position: absolute; z-index: 1; width: 100%; height: 100%; object-fit: cover;">
            <input name="dataImage" type="hidden" value={{Post.contens.image}}>
            <textarea name="contens" id="contens"
                style="position: absolute; z-index: 2; width: 100%; height: 100%; background: transparent; resize: none; font-size: 16px; color: black;">{{Post.contens.text}}</textarea>
        </div>

        <!-- Select background -->
        <div>
            <select id="ground">
                <option value="">-- Chọn Picture --</option>
                <option value="/pictures/avatar.jpg">img 1</option>
                <option value="/pictures/image-1754515454077-261962452.png">img 2</option>
                <option value="/pictures/image-1754516183050-615377140.png">img 3</option>
            </select>

            <!-- Select emoji -->
            <select id="emoji">
                <option value="">-- Chọn emoji --</option>
                <option value="👍">👍</option>
                <option value="😀">😀</option>
                <option value="😢">😢</option>
                <option value="😂">😂</option>
                <a href="">upload pictures</a>

            </select>
            <input type="file" id="fileInput" accept="image/*">
            <button id="upload">upload</button>
        </div>

        <!-- Submit -->
        <div>
            <button id="submit">Submit</button>
        </div>
    </div>
</form>

<script type="module" src="/js/post-editor.js"></script>