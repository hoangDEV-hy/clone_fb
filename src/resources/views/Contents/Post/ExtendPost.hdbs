<form action="">
    <div>
        <div style="display:flex">
            {{#if Post.PostId_origin}}
            <input type="hidden" id="PostId_original" value="{{Post.PostId_origin}}">
            <input type="hidden" id="PostId_curtain" value="{{Post.id}}">
            {{else}}
            <input type="hidden" id="PostId_original" value="{{Post.id}}">
            <input type="hidden" id="PostId_curtain" value="">
            {{/if}}
            {{!-- for update --}}
            <input type="hidden" id="groupId" value="{{group_id}}{{Post.group_id}}">
            <input type="hidden" id="userId" value="{{user.id}}{{Post.user_id}}">

            <img src="{{user.avatar}}{{Post.users.avatar}}" alt="" style="width:50px;height:50px;border-radius:50%;">
            <h3>{{user.name}}{{Post.users.name}}</h3>




            <select id="scope">
                <option value="">-- Chọn phạm vi truy cập --</option>
                <option value="only_me">only_me</option>
                <option value="public">public</option>
                <option value="group">group</option>
            </select>
        </div>

        <!-- Khung chứa background + textarea -->
        <div style="position: relative; width: 300px; height: 200px;">
            <textarea name="contens" id="contens" placeholder="vui long nhap noi dung">{{Post.think}}</textarea>
            <div>
                <img name="background" src="" alt=""
                    style="position: absolute; z-index: 1; width: 100%; height: 100%; object-fit: cover;">
                <input name="dataImage" type="hidden"
                    value='{{#if conten.image}}{{{json conten.image}}}{{else}}{{{json Post.contens.image}}}{{/if}}'>
                <textarea name="text" id="text"
                    style="position: absolute; z-index: 2; width: 100%; height: 100%; background: transparent; resize: none; font-size: 16px; color: black;">{{conten.text}}{{Post.contens.text}}</textarea>
            </div>
        </div>

        <!-- Select background -->
        <div>


            <!-- Select emoji -->
            <select id="emoji">
                <option value="">-- Chọn emoji --</option>
                <option value="👍">👍</option>
                <option value="😀">😀</option>
                <option value="😢">😢</option>
                <option value="😂">😂</option>
                <a href="">upload pictures</a>

            </select>

        </div>

        <!-- Submit -->
        <div>
            <button id="submit">Submit</button>
        </div>
    </div>
</form>

<script type="module" src="/js/post-share.js"></script>