<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Giả Lập Facebook</title>


</head>
<style>
    [data-role="message"].selected {
        border: 2px solid red;
        background: #ffeaea;
    }

    .overlayConfirm {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .dialogConfirm {
        width: 350px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.2);
    }

    .actionsConfirm {
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .actionsConfirm button {
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .actionsConfirm button:last-child {
        background: #1877f2;
        color: white;
        border: none;
    }

    .menu {
        display: none;
        position: absolute;
        background: white;
        border: 1px solid #ccc;
        z-index: 1000;
    }

    .menu.active {
        display: block;
    }

    .follow-toggle-btn[data-status="following"] {
        color: #1877f2;
        font-weight: 600;
    }

    .follow-toggle-btn[data-status="not-following"] {
        color: #050505;
    }

    .follow-toggle-btn[data-status="loading"] {
        color: #65676b;
        font-style: italic;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #18191a;
        color: #e4e6eb;
        padding: 20px;
    }

    .suggestions-container {
        max-width: 680px;
        margin: 0 auto 20px;
        background: #242526;
        border-radius: 8px;
        padding: 16px;
    }

    .suggestions-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .suggestions-header h2 {
        font-size: 20px;
        font-weight: 600;
    }

    .view-all {
        color: #2d88ff;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
    }

    .view-all:hover {
        text-decoration: underline;
    }

    .suggestions-wrapper {
        position: relative;
    }

    .suggestions-scroll {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .suggestions-scroll::-webkit-scrollbar {
        display: none;
    }

    .suggestion-card {
        flex: 0 0 auto;
        width: 160px;
        background: #3a3b3c;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.2s;
        position: relative;
    }

    .suggestion-card:hover {
        transform: translateY(-4px);
    }

    .card-avatar {
        width: 100%;
        height: 160px;
        position: relative;
        overflow: hidden;
        background: #4a4b4c;
    }

    .card-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-avatar-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 600;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .card-info {
        padding: 12px;
    }

    .card-name {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mutual-friends {
        font-size: 13px;
        color: #b0b3b8;
        margin-bottom: 12px;
    }

    .card-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn {
        padding: 8px;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-primary {
        background: #2d88ff;
        color: white;
    }

    .btn-primary:hover {
        background: #1877f2;
    }

    .btn-secondary {
        background: #3a3b3c;
        color: #e4e6eb;
    }

    .btn-secondary:hover {
        background: #4a4b4c;
    }

    .nav-button {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        transition: all 0.2s;
    }

    .nav-button:hover {
        background: white;
        transform: translateY(-50%) scale(1.1);
    }

    .nav-button.prev {
        left: -12px;
    }

    .nav-button.next {
        right: -12px;
    }

    .nav-button svg {
        width: 20px;
        height: 20px;
        fill: #050505;
    }

    .nav-button:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .loading {
        text-align: center;
        padding: 40px;
        color: #b0b3b8;
    }

    .error {
        text-align: center;
        padding: 40px;
        color: #f02849;
    }

    /* Loading skeleton */
    .skeleton {
        animation: pulse 1.5s ease-in-out infinite;
    }

    @keyframes pulse {

        0%,
        100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    .skeleton-card {
        flex: 0 0 auto;
        width: 160px;
        background: #3a3b3c;
        border-radius: 8px;
        overflow: hidden;
    }

    .skeleton-avatar {
        width: 100%;
        height: 160px;
        background: #4a4b4c;
    }

    .skeleton-info {
        padding: 12px;
    }

    .skeleton-line {
        height: 16px;
        background: #4a4b4c;
        border-radius: 4px;
        margin-bottom: 8px;
    }

    .skeleton-line.short {
        width: 60%;
    }

    .mutual-friends-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .mutual-friends-modal.active {
        display: flex;
    }

    .modal-content {
        background: #242526;
        border-radius: 8px;
        width: 90%;
        max-width: 500px;
        max-height: 80vh;
        overflow-y: auto;
    }

    .modal-header {
        padding: 16px;
        border-bottom: 1px solid #3a3b3c;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        font-size: 20px;
    }

    .close-modal {
        background: #3a3b3c;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-body {
        padding: 16px;
    }

    .mutual-friend-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px;
        border-radius: 8px;
        margin-bottom: 4px;
    }

    .mutual-friend-item:hover {
        background: #3a3b3c;
    }

    .mutual-friend-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
        background: #4a4b4c;
    }

    .mutual-friend-info h4 {
        font-size: 15px;
        font-weight: 600;
    }
</style>

<body>
    <div id="bd_ct_news_cmd_tuongTac_nenMo"></div>
    <div class="header">
        <ul class="navbar">
            <li class="logo">
                <img src="/pictures/image-1754515454077-261962452.png" alt="logo">
            </li>

            <li class="search">
                <a href="/searches">Tìm kiếm</a>
            </li>

            <li><a href="/page_manager/friends/joined">Bạn bè</a></li>

            <!-- Tin nhắn -->
            <li class="menu-btn" data-menu="mes">
                Tin nhắn
                <ul class="mes menu">
                    <li><strong>Tin Nhắn</strong></li>
                    <li class="divider"></li>
                    <li><a href="#">Nguyễn Hoàng</a></li>
                    <li><a href="#">Bùi Huy</a></li>
                    <li><a href="#">Văn Hiệu</a></li>
                    <li><a href="#">Quảng Nam</a></li>
                </ul>
            </li>

            <!-- Thông báo -->
            <li class="menu-btn" data-menu="thongBao">
                Thông Báo
                <span id="unreadBadge" class="badge"></span>
                <ul class="thongBao menu">
                    <li><strong>Thông Báo</strong></li>
                    <li class="divider"></li>
                    <li id="notificationList">Đang tải...</li>
                </ul>
            </li>

            <!-- Profile -->
            <li class="my_profile menu-btn" data-menu="submenu">
                <form action="http://localhost:3000/page_manager/user" method="POST" style="display: inline;">
                    <input type="hidden" name="selectedTargetId" value="{{user.id}}">
                    <button type="submit"
                        style="background: none; border: none; color: blue; text-decoration: underline; cursor: pointer; padding: 0; font: inherit;">
                        Trang cá nhân
                    </button>
                </form>
                <img src="{{user.avatar}}" alt="ảnh đại diện">
                Tài khoản
                </a>
                <ul class="submenu menu">
                    <li>{{user.name}}</li>
                    <li>
                        <input type="hidden" value="{{user.id}}">
                    </li>
                </ul>
            </li>

            <!-- Settings -->
            <li class="menu-btn" data-menu="subsubmenu">
                Cài đặt
                <ul class="subsubmenu menu">
                    <li>Ngôn Ngữ</li>
                </ul>
            </li>

            <li><a href="#">Trợ giúp và hỗ trợ</a></li>
            <li><a href="#">Màn hình và trợ năng</a></li>
            <li><a href="#">Đóng góp ý kiến</a></li>
            <li><a href="/logout">Đăng xuất</a></li>
        </ul>

    </div>
    <div class="body" style="display: flex">
        <div class="body_center">
            <div class="suggestions-container">
                <div class="suggestions-header">
                    <h2>Những người bạn có thể biết</h2>
                    <a href="#" class="view-all">Xem tất cả</a>
                </div>

                <div class="suggestions-wrapper">
                    <button class="nav-button prev" id="prevBtn" disabled>
                        <svg viewBox="0 0 24 24">
                            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
                        </svg>
                    </button>

                    <div class="suggestions-scroll" id="suggestionsScroll">
                        <!-- Loading skeleton -->
                        <div class="skeleton-card skeleton">
                            <div class="skeleton-avatar"></div>
                            <div class="skeleton-info">
                                <div class="skeleton-line"></div>
                                <div class="skeleton-line short"></div>
                                <div class="skeleton-line"></div>
                                <div class="skeleton-line"></div>
                            </div>
                        </div>
                        <div class="skeleton-card skeleton">
                            <div class="skeleton-avatar"></div>
                            <div class="skeleton-info">
                                <div class="skeleton-line"></div>
                                <div class="skeleton-line short"></div>
                                <div class="skeleton-line"></div>
                                <div class="skeleton-line"></div>
                            </div>
                        </div>
                        <div class="skeleton-card skeleton">
                            <div class="skeleton-avatar"></div>
                            <div class="skeleton-info">
                                <div class="skeleton-line"></div>
                                <div class="skeleton-line short"></div>
                                <div class="skeleton-line"></div>
                                <div class="skeleton-line"></div>
                            </div>
                        </div>
                    </div>

                    <button class="nav-button next" id="nextBtn">
                        <svg viewBox="0 0 24 24">
                            <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal hiển thị bạn chung -->
            <div class="mutual-friends-modal" id="mutualFriendsModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3 id="modalTitle">Bạn chung</h3>
                        <button class="close-modal" id="closeModal">✕</button>
                    </div>
                    <div class="modal-body" id="modalBody">
                        <!-- Nội dung bạn chung sẽ được load ở đây -->
                    </div>
                </div>
            </div>
            <div id="think">
                <textarea placeholder="Bạn đang nghĩ gì?"></textarea>
                <a href="/Posts">tạo tin</a>
            </div>
            <div class="bd_ct_news_cmd_tuongTac_pop" style="display:none;">
                <iframe id="myIframe" src="/Post/iframe/commend" style="width:100%; height:400px; "></iframe>
            </div>
            <div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1055;"></div>


            {{#each allPosts}}
            <div class="news">
                <input type="hidden" name="news" value="{{id}}">
                <input type="hidden" name="post_owner_id" value="{{users.id}}">
                <div class="bd_ct_news_nguoiDang">
                    <div class="bd_ct_n_nguoiDang_anh" style="position: relative;">
                        <div style="top:0%">
                            <img src="{{users.avatar}}" alt="avatar">
                        </div>
                    </div>
                    <div class="bd_ct_n_nguoiDang_name">
                        {{#if group_id}}
                        <h3>{{groups.name}}</h3>
                        {{/if}}
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <!-- Click vào tên để vào trang cá nhân -->
                            <h4>
                                <form action="http://localhost:3000/page_manager/user" method="POST"
                                    style="display: inline;">
                                    <input type="hidden" name="selectedTargetId" value="{{users.id}}">
                                    <button type="submit"
                                        style="background: none; border: none; color: blue; text-decoration: underline; cursor: pointer; padding: 0; font: inherit;">
                                        Trang cá nhân
                                    </button>
                                </form>
                                <h5>{{users.name}} · {{time updatedAt}}</h5>
                            </h4>

                            <!-- Menu 3 chấm -->
                            <div class="post-menu-container" style="position: relative;">
                                <button class="post-menu-btn" data-user-id="{{users.id}}"
                                    data-post-id="{{id}}">⋮</button>
                                <ul class="post-menu" style="display: none;">
                                    <!-- Button follow/unfollow sẽ được JS thay đổi động -->
                                    <li class="follow-toggle-btn" data-user-id="{{users.id}}" data-status="loading">
                                        Đang kiểm tra...
                                    </li>
                                    <li class="hide-post-btn" data-post-id="{{id}}">Ẩn bài viết</li>
                                    <li class="report-post-btn" data-post-id="{{id}}">Báo cáo</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2>{{think}}</h2>
                        <div class="bd_ct_news_title">
                            <input type="hidden" class="image_src_input" value='{{json contens.image}}'>
                            <h3>{{contens.text}}</h3>
                            <img class="image_src_img" src="">
                        </div>
                    </div>

                    <div class="bd_ct_news_commend">
                        <div id="bd_ct_news_commend_thongKe_news{{id}}">
                            <p id="bd_ct_news_cmd_tk_text_news{{id}}"></p>
                        </div>
                        <div class="bd_ct_news_commend_tuongTac">
                            <input type="checkbox" class="like-checkbox" id="{{id}}" data-id="{{id}}">like
                            <button name="commend" data-id="{{id}}">Bình luận</button>

                            <form action="/Post/share" method="Post">
                                <input type="hidden" name="id_Post" value={{id}}>
                                <button type="submit">Chia sẻ</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}

            <button id="loadMoreBtn">Load more</button>

        </div>
        <div class="body_right">

            <h2>Người liên hệ</h2>
            <ul data-role="friendList">
                {{#each friend_array}}
                <li data-id="{{id}}">
                    <img src="{{avatar}}" width="30" height="30" alt="{{name}}">
                    <span>{{name}}</span>
                </li>
                {{/each}}
            </ul>
            <ul data-role="myRoom">
                <li>Room 1</li>
                <li>Room 2</li>
            </ul>


            <div data-role="chatBox" style="display: none;">
                <div data-role="chatHead" style="display: flex;">
                    <h3 data-role="head_name">ten</h3>
                    <input type="hidden" data-role="head_chatId">
                    <img src="" alt="tagetPicture">
                    <button data-role="add_member">thêm thành viên</button>
                    <select data-role="head_option">
                        <option>----------</option>
                        <option value="delete">delete</option>
                        <option value="submit">submit</option>
                        <option value="cancel">cancel</option>
                        <option value="edit_nickName">changing nickname</option>
                        <option value="select_members">show members</option>

                    </select>
                    <button data-role="head_close">close</button>
                </div>
                <div data-role="contain_chat" style="display: flex;">
                    <div data-role="contain_otherChat">

                    </div>
                    <div data-role="contain_myChat">

                    </div>
                </div>
                <div data-role="notification"></div>
                <div data-role="chatFooter">
                    <select data-role="typeMes">

                        <option>----------</option>
                        <option value="voice">voice</option>
                        <option value="emoji">emoji</option>
                        <option value="picture">picture</option>
                    </select>
                    <emoji-picker style="display: none;"></emoji-picker>
                    <div data-role="voiceAction" style="display: none;">
                        <button data-role="start_voice">start</button>
                        <button data-role="end_voice">end</button>
                        <audio data-role="replay_voice" controls></audio>
                    </div>
                    <input type="file" data-role="upload_img" style="display: none;" accept="image/*, image/jpeg">

                    <textarea data-role="contentChat"></textarea>
                    <button data-role="send_mes">send</button>
                </div>
            </div>
        </div>
        <!-- ========== MODAL ĐỒNG Ý / HUỶ ========== -->
        <div id="overlayConfirm" class="overlayConfirm">
            <div class="dialogConfirm">
                <h3>Bạn muốn tiếp tục?</h3>
                <p>Hành động này có thể thay đổi dữ liệu!</p>

                <div class="actionsConfirm">
                    <button id="btnCancelConfirm">Huỷ</button>
                    <button id="btnOkConfirm">Đồng ý</button>
                </div>
                </divS /div>
                <!-- ========== /MODAL ========== -->
                <!-- Friend Suggestions Scripts -->
                <script src="/js/Suggestion/ApiService.js"></script>
                <script src="/js/Suggestion/UiService.js"></script>
                <script src="/js/Suggestion/ToastService.js"></script>
                <script src="/js/Suggestion/ModalService.js"></script>
                <script src="/js/Suggestion/ScrollService.js"></script>
                <script src="/js/Suggestion/SuggestionsController.js"></script>
                <script src="/js/Suggestion/SuggestionActions.js"></script>
</body>
<script src="/socket.io/socket.io.js"></script>
<!-- CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- JS (bundle + Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js"></script>
<script type="module">
    import handle_image from '/js/support/handle_image.js';
    import interactions from '/js/interactions/run_interactionFunctions.js'
    import loadHandleConfig_chat from '/js/chat/loadHandleConfig_chat.js'
    import featureOfChat from '/js/chat/featureOfChat.js'
    import notification from '/js/Notification/notification.js'
    import NotificationCenter from '/js/Notification/NotificationCenter.js';
    // expose ra global để HTML onclick dùng được
    window.NotificationCenter = NotificationCenter;

    import follow from '/js/Follow.js';
    import reloadMain from '/js/ReloadMain.js'



    document.addEventListener('DOMContentLoaded', async () => {
        // xử lý ảnh base64 từ hidden input
        handle_image('.bd_ct_news_title', '.image_src_img', '.image_src_input');

        //for load_Posts, change_like
        const id_user = document.querySelector('.my_profile input').value;
        //for load_Posts, set_like
        let data_load;
        //for set_like, change_like
        const nameCheckInput = '.like-checkbox';
        //for send_commends, handle_dataIframe
        const nameContainIframe = '.bd_ct_news_cmd_tuongTac_pop';
        //for send_commends, handle_dataIframe, change_like, save_toDB
        let change_like = {};
        // lưu dữ liệu comment từ iframe
        let add_commends = [];
        //save the delete commend data
        let deleted_commends = [];
        //save the update commend data
        let update_commends = [];
        interactions(change_like, id_user, nameContainIframe, data_load, add_commends, deleted_commends, update_commends);


        //chatBox
        let socket = io({
            reconnection: true,
            reconnectionAttempts: 5,
            reconnectionDelay: 1000,
            timeout: 10000
        });
        socket.onAny((eventName, ...args) => {
            console.log('📤 Event nhận từ server');
            console.log('Event:', eventName);
            console.log('Data:', args);
        });
        socket.emit('register', id_user);

        console.log('✅ Socket connected:', socket.id);
        let reconnectAttempts = 0;
        const MAX_RECONNECT_ATTEMPTS = 5;
        let notificationShown = false;

        // Hàm hiển thị thông báo
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
    position: fixed;
    top: 20px;
    right: 20px;
    padding: 15px 20px;
    background: ${type === 'error' ? '#f44336' : '#2196F3'};
    color: white;
    border-radius: 5px;
    z-index: 9999;
  `;
            document.body.appendChild(notification);

            setTimeout(() => notification.remove(), 3000);
        }

        socket.on('connect', () => {
            console.log('Kết nối thành công! Socket ID:', socket.id);
            reconnectAttempts = 0;
            notificationShown = false;
            showNotification('Đã kết nối đến server', 'success');
        });

        socket.on('disconnect', (reason) => {
            console.log('Mất kết nối:', reason);
            showNotification('Mất kết nối với server', 'error');

            if (reason === 'io server disconnect') {
                setTimeout(() => {
                    window.location.href = './404.html';
                }, 2000);
            }
        });

        socket.on('connect_error', (error) => {
            reconnectAttempts++;

            if (!notificationShown) {
                showNotification(`Đang thử kết nối lại... (${reconnectAttempts}/${MAX_RECONNECT_ATTEMPTS})`, 'error');
                notificationShown = true;
            }

            if (reconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
                showNotification('Không thể kết nối đến server. Chuyển hướng...', 'error');
                setTimeout(() => {
                    window.location.href = './404.html';
                }, 2000);
            }
        });

        socket.on('reconnect_attempt', (attemptNumber) => {
            console.log(`Thử kết nối lại lần ${attemptNumber}`);
        });

        socket.on('reconnect_failed', () => {
            showNotification('Kết nối thất bại. Chuyển hướng...', 'error');
            setTimeout(() => {
                window.location.href = '/404.html';
            }, 2000);
        });
        let chatState = {
            receiver_id: null,
            head_name: null,
            chat_id: null
        };
        async function handle_functions(socket, chatState, id_user) {
            // Load chatState asynchronously
            chatState = await loadHandleConfig_chat.load_chat(socket, id_user, chatState);
            // Send message asynchronously
            featureOfChat.send_mes(id_user, chatState.receiver_id, socket);
            // Return the updated chatState
            return chatState;
        }
        //for realtime notifications
        socket.on('badge_increment', (badge_increment) => {
            console.log('badge_increment run')
            const badge = document.getElementById('unreadBadge');
            if (!badge) return;

            const current = parseInt(badge.textContent || '0', 10);
            const newCount = current + badge_increment;

            NotificationCenter.updateUnreadBadge(newCount);
        })

        // Usage
        handle_functions(socket, chatState, id_user)
            .then(updatedChatState => {
            })
            .catch(err => console.error("Error:", err));

        //for reloading mes from server
        const containChat = document.querySelector('[data-role="contain_chat"]');
        const myChat = containChat.querySelector('[data-role="contain_myChat"]');
        const otherChat = containChat.querySelector('[data-role="contain_otherChat"]');
        socket.on('receive_mes', (data) => {
            if (String(data[0].chatID) !== chatState.chat_id.value) {
                console.log('notification'); return
            }
            loadHandleConfig_chat.handleChatData(data, myChat, otherChat, chatState.receiver_id);
        });


        //featureOfChat
        //delete event
        const chatHead = document.querySelector('[data-role="chatHead"]');
        const head_option = chatHead.querySelector('[data-role="head_option"]');

        let selecter_messages;
        head_option.addEventListener('change', async (e) => {
            let contain_myChat = document.querySelector('[data-role="contain_myChat"]')
            const value = e.target.value;
            if (['delete', 'submit', 'cancel'].includes(value)) {
                selecter_messages = await featureOfChat.del_mes(e, contain_myChat, selecter_messages);
            }
            //edit_name
            if (e.target.value === 'edit_nickName') {
                featureOfChat.edit_nickName(id_user, chatState);
            }
            //select_members
            if (e.target.value === 'select_members') {
                featureOfChat.select_members(myIframe, nameContainIframe);
            }

        });
        //notifications
        notification.define();
        //generate a notificationn & handle_notification
        socket.on('create_notification', (data, callback) => {
            if (data) {
                if (data.type === "invited_joinChat") {
                    notification.generate_notification(data, "Thông báo", "invited_joinChat", socket);
                }
                else if (data.type === "static") {
                    notification.generate_notification(data, "Thông báo", "static", socket);
                } else {
                    //notification.generate_notification(data, "Thông báo", "unknownType");
                }
            }
            else {
                console.log('khong ton tai data.content');
                // Vẫn gửi acknowledgment nếu có callback nhưng data không hợp lệ
                if (callback && typeof callback === 'function') {
                    callback({ received: false });
                }
            }
        });

        //event click_listRoom
        document.querySelectorAll('[data-role="myRoom"]').forEach(el => {
            el.addEventListener('click', (e) => {
                console.log(e.target.textContent.trim());
            }
            )
        })

        //event add member to chat
        document.querySelector('[data-role="add_member"]').addEventListener('click', () => {
            const iframe = document.getElementById('myIframe');
            iframe.src = '/mess/chat_room/people';
            document.querySelector(nameContainIframe).style.display = "block";
            //for searching chat_room, friend
            let chat_roomUserId = {
                chat_roomId: chatState.chat_id.value,
                idUser: id_user
            };
            iframe.onload = () => {
                iframe.contentWindow.postMessage(chat_roomUserId, window.location.origin);
            };
            let close_buttonIframe = document.createElement('button');
            close_buttonIframe.addEventListener('click', () => {
                document.querySelector(nameContainIframe).style.display = "none";
            })
            document.querySelector(nameContainIframe).appendChild(close_buttonIframe);
        })

        // ================= MENU / NOTIFICATION =================
        const menus = document.querySelectorAll('.menu');
        const menuButtons = document.querySelectorAll('.menu-btn');

        function closeAllMenus() {
            menus.forEach(menu => menu.classList.remove('active'));
        }

        menuButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation(); // ⛔ rất quan trọng

                const className = btn.dataset.menu;
                if (!className) return;

                const menu = document.querySelector(`.${className}`);
                if (!menu) return;

                const isOpen = menu.classList.contains('active');

                // đóng tất cả trước
                closeAllMenus();

                // toggle
                if (!isOpen) {
                    menu.classList.add('active');

                    // load notification khi mở thông báo
                    if (className === 'thongBao') {
                        NotificationCenter.loadNotifications(id_user, 1);

                    }
                }
            });
        });

        // Click bên trong menu (nút xoá, item…) → KHÔNG đóng
        menus.forEach(menu => {
            menu.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        });

        // Click ra ngoài → đóng tất cả menu
        document.addEventListener('click', () => {
            closeAllMenus();
        });


        // ========== XỬ LÝ MENU 3 CHẤM VỚI FOLLOW ĐỘNG ==========
        document.addEventListener('click', async (e) => {
            // Mở menu khi click nút 3 chấm
            if (e.target.classList.contains('post-menu-btn')) {
                e.stopPropagation();

                const targetUserId = e.target.dataset.userId;
                const menu = e.target.nextElementSibling;
                const followBtn = menu.querySelector('.follow-toggle-btn');

                // Đóng tất cả menu khác
                document.querySelectorAll('.post-menu').forEach(m => m.style.display = 'none');

                // Mở menu hiện tại
                menu.style.display = 'block';

                // Kiểm tra trạng thái follow ngay khi mở menu
                await follow.checkAndUpdateFollowStatus(followBtn, id_user, targetUserId);
                return;
            }

            // Toggle Follow/Unfollow
            if (e.target.classList.contains('follow-toggle-btn')) {
                e.stopPropagation();
                const targetUserId = e.target.dataset.userId;
                const currentStatus = e.target.dataset.status;

                if (currentStatus === 'following') {
                    await follow.handleUnfollow(e.target, id_user, targetUserId);
                } else if (currentStatus === 'not-following') {
                    await follow.handleFollow(e.target, id_user, targetUserId);
                }
                return;
            }

            // Ẩn bài viết
            if (e.target.classList.contains('hide-post-btn')) {
                const postId = e.target.dataset.postId;
                follow.handleHidePost(postId);
                return;
            }

            // Báo cáo
            if (e.target.classList.contains('report-post-btn')) {
                const postId = e.target.dataset.postId;
                follow.handleReport(postId);
                return;
            }

            // Click ra ngoài → đóng menu
            document.querySelectorAll('.post-menu').forEach(m => m.style.display = 'none');
        });

        // Khởi tạo khi trang load
        window.addEventListener('load', async () => {
            NotificationCenter.init(id_user, 1);

            // for reset cache feed
            await reloadMain(id_user);
        });
        document.querySelector('.logo').addEventListener('click', async () => {
            await reloadMain(id_user);
        });

        //phan trang bai viet
        document.getElementById('loadMoreBtn').addEventListener('click', () => {
            let nextCursor = "{{cursor}}";
            console.log('nextCursor', nextCursor)
            const params = new URLSearchParams();
            params.append('limit', 10);

            if (nextCursor) {
                params.append('cursor', nextCursor);
            }

            window.location.href = `/main?${params.toString()}`;
        });
    })

    async function initFriendSuggestions() {
        // Lấy userId từ DOM
        const userInput = document.querySelector('.my_profile input');
        if (!userInput) {
            console.error('User input not found');
            return;
        }

        const userId = userInput.value;
        if (!userId) {
            console.error('User ID not found');
            return;
        }

        // Khởi tạo animations
        toastService.addAnimations();

        // Khởi tạo các services
        modalService.init();
        scrollService.init('suggestionsScroll', 'prevBtn', 'nextBtn');

        // Khởi tạo controller và load suggestions
        await suggestionsController.init(userId);
    }

    // Auto initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFriendSuggestions);
    } else {
        initFriendSuggestions();
    }
</script>

</html>