<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Giả Lập Facebook</title>
    <link rel="stylesheet" href="main.css">

</head>

<body>
    <div id="bd_ct_news_cmd_tuongTac_nenMo"></div>
    <div class="header">
        <ul class="navbar">
            <li><img src="./img/Facebook_Logo_(2019).png" alt="logo"></li>
            <li><input type="text" placeholder="Tìm kiếm..."></li>
            <li><a href="">Trang chủ</a></li>
            <li><a href="./friend.html">Bạn bè</a></li>
            <li><a href="./video.html">Phim</a></li>


            <li onclick="hienMenu('mes')">Tin nhắn
                <ul class="mes menu">
                    <li>Tin Nhắn</li>
                    <li>-------------</li>
                    <li><a href="">Nguyễn Hoàng</a></li>
                    <li><a href="">Bùi Huy</a></li>
                    <li><a href="">Văn Hiệu</li>
                    <li><a href="">Quảng Nam</a></li>
                </ul>
            </li>
            <li onclick="hienMenu('thongBao')">Thông Báo
                <ul class="thongBao menu">
                    <li>Thông Báo</li>
                    <li>-------------</li>
                    <li class="avt"> Nguyễn Hoàng: gửi tin nhắn</li>
                    <li class="avt"> Nguyễn Hoàng: mời bạn tham gia nhóm</li>
                </ul>
            </li>
            <li><a href="profile.htm"><img src="./img/426309418_1440256106901425_3011488708200489727_n.jpg" <li
                        onclick="hienMenu('submenu')">Tài khoản
                    <ul class="submenu menu">
                        alt="ảnh nền">
                        Nguyễn Hoàng
                </a></li>
            <li onclick="hienMenu('subsubmenu')">Cài đặt
                <ul class="subsubmenu menu">Ngôn Ngữ</ul>
            </li>
            <li><a href="#">Trợ giúp và hỗ trợ</a></li>
            <li><a href="#">Màn hình và trợ năng</a></li>
            <li><a href="#">Đóng góp ý kiến</a></li>
            <li><a href="#">Đăng xuất</a></li>
        </ul>
        </li>

        </ul>

    </div>
    <div class="body">
        <div class="body_center">
            <div id="think">
                <textarea placeholder="Bạn đang nghĩ gì?"></textarea>
                <a href="/essays">tạo tin</a>
            </div>
            {{#each allEssays}}
            <div id="news{{id}}">
                <div class="bd_ct_news_nguoiDang">
                    <div class="bd_ct_n_nguoiDang_anh" style="position: relative;">
                        <div style="top:0%">
                            <img src="/{{users.avatar}}" alt="avatar">
                        </div>
                    </div>
                    <div class="bd_ct_n_nguoiDang_name">
                        {{#if group_id}}
                        <h3>{{groups.name}}</h3>
                        {{/if}}
                        <h4>{{users.name}} · {{time updatedAt}}</h4>
                    </div>

                    <div>
                        <h2>{{think}}</h2>
                        <div class="bd_ct_news_title">
                            <input type="hidden" class="image_src_input" value='{{json contens.image}}'>
                            <h3>{{contens.text}}</h3>
                            <img class="image_src_img" src="">
                        </div>
                    </div>

                    <div class="bd_ct_news_commend">
                        <div id="bd_ct_news_commend_thongKe_news{{id}}">
                            <p id="bd_ct_news_cmd_tk_text_news{{id}}" value="230">230 người khác</p>
                        </div>
                        <div id="bd_ct_news_commend_tuongTac">
                            <input type="checkbox" class="like-checkbox" data-id="{{id}}">like
                            <button onclick="binhLuan('news{{id}}')">Bình luận</button>
                            <form action="/essay/share" method="post">
                                <input type="hidden" name="id_essay" value={{id}}>
                                <button type="submit">Chia sẻ</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}


        </div>
        <div class="body_right">

            <h2>Người liên hệ</h2>
            <ul>
                <li><a href="#" onclick="openMes()">Hiệu Phạm</a></li>
                <li><a href="#" onclick="openMes()">Bùi Huy</a></li>
                <li>Đặng Thiên</li>
                <li>Huy Trần Gia</li>
                <li>Văn Khiêm</li>
                <li>Việt Dũng</li>
                <li>Thảo Lê</li>
                <li>Linh Phương</li>
                <li>Đàm</li>
                <li>Phạm Văn Thành</li>
            </ul>
            <iframe id="bodyright_mesifP"></iframe>
        </div>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.bd_ct_news_title').forEach(container => {
                    try {
                        // Lấy hidden input trong div
                        let hiddenInput = container.querySelector('.image_src_input');
                        if (!hiddenInput) return;

                        // Lấy JSON string từ value
                        let data = hiddenInput.value;
                        console.log("Raw hidden value:", data);

                        // Parse sang object
                        data = JSON.parse(data);

                        // Gắn src cho img
                        let imgElement = container.querySelector('.image_src_img');
                        if (imgElement && data.mimeType && data.base64) {
                            imgElement.src = `data:${data.mimeType};base64,${data.base64}`;
                        }
                    } catch (e) {
                        console.error("Lỗi xử lý ảnh:", e);
                    }
                });
                const checkbox = document.getElementById("like");


                document.querySelectorAll('.like-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', async (e) => {
                        const isCheck = e.target.checked;
                        const id_essay = e.target.dataset.id;
                        const url = '/essay/like';
                        const method = isCheck ? "POST" : "DELETE";
                        const formData = new FormData();
                        formData.append('id_essays', id_essay);
                        formData.append('classify', 'like');

                        try {
                            await fetch(url, {
                                method,
                                body: formData
                            });
                            console.log(isCheck ? "Added" : "Deleted");
                        } catch (err) {
                            console.error("API failed:", err);
                        }
                    });
                });
            });

        </script>
</body>

</html>