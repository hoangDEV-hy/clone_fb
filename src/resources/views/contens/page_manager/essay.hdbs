<div>
    <h1>Quản lý bài đăng nhóm</h1>
    <div style="display: flex;">
        <div>
            <h3>{{group.name}}</h3>


            <img src="" alt="">
            {{#if isAdmin}}
            <div><a href="/admin"></a></div>
            {{/if}}
        </div>
        {{#each essay}}
        <div id="news{{id}}">
            <div class="bd_ct_news_nguoiDang">
                <div id="bd_ct_n_nguoiDang_anh" style="position: relative;">
                    <div style="top:0%">
                        <img src="{{../user.avatar}}" alt="ảnh con">
                    </div>
                </div>
                <div id="bd_ct_n_nguoiDang_name">
                    <h4>{{../user.name}} . {{time essay.updatedAt}}</h4>
                    <div>

                        <form action="/page_manager/essay/del?_method=DELETE" method="post" style="display:inline">
                            <input type="hidden" name="id" value="{{id}}">
                            <button type="submit">delete</button>
                        </form>
                        <a href="/page_manager/essay/update">update</a>
                    </div>
                </div>

                <div class="bd_ct_news_title">
                    <input type="hidden" value="{{id}}">
                    <h3>{{text}}</h3>
                    <input class="image_src" type="hidden" value="{{image}}">
                    <img class="image_src" src="" alt="ảnh news">
                </div>
                <div class="bd_ct_news_commend">
                    <div id="bd_ct_news_commend_thongKe_news{{id}}">
                        <p id="bd_ct_news_cmd_tk_text_news{{id}}" value="230">230 người khác</p>
                    </div>
                    <div id="bd_ct_news_commend_tuongTac">
                        <button onclick="like('news{{id}}')">thích</button>
                        <button onclick="binhLuan('news{{id}}')">Bình luận</button>
                        <button onclick="chiaSe()">chia sẻ</button>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('input.image_src').forEach((hiddenInput, index) => {
            try {
                let data = JSON.parse(hiddenInput.value); // Giải mã JSON từ DB
                let imgElement = hiddenInput.parentElement.querySelector('img.image_src');

                if (imgElement && data.mimeType && data.base64) {
                    imgElement.src = `data:${data.mimeType};base64,${data.base64}`;
                }
            } catch (e) {
                console.error("Lỗi parse ảnh:", e);
            }
        });
    });
</script>