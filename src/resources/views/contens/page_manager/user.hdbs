<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../../../../css/contens/page_manager/user.css">
    <style>
    </style>
</head>

<body>
    <div class="head">
        <img src="/{{user.thumbnail}}" alt="ảnh thumbnai">

        <table>
            <tr>
                <th>
                    <table>

                        <th style="width: 10%;">
                            <form action="/page_manager/user/upload/thumbnail" method="post"
                                enctype="multipart/form-data">
                                <input type="file" name="image" accept="image/*" required>
                                <button type="submit">Tải lên</button>
                                <img src="/{{user.avatar}}" alt="avt">
                            </form>

                        </th>
                        <th style="width: 90%;">
                            <form action="/page_manager/user/update/avatar" method="post">
                                <input type="text" name="name" value="{{user.name}}">
                                <input type="text" name="hastag" value="{{user.hastag}}">
                                <button type="submit">xác nhận</button>
                            </form>
                        </th>

                    </table>
                </th>
                <th>
                    <div id="head_button">
                        <button>chỉnh sửa trang cá nhân</button>
                    </div>
                </th>
            </tr>
        </table>
    </div>

    <div class="body">
        <div id="think">
            <textarea placeholder="Bạn đang nghĩ gì?"></textarea>
            <button>Tạo tin</button>
        </div>
        {{#each essays}}
        <div class="news">
            <div class="bd_ct_news_nguoiDang">
                <table>
                    <tr>
                        <th> <img style="width: 50px;height: 50px;" src="/{{users.avatar}}" alt="ảnh con"></th>
                        <th>
                            <h3>{{users.name}}</h3>
                        </th>
                        <th></th>
                    </tr>

                    <tr>
                        <th></th>
                        <th>
                            <h4>{{time updatedAt}}</h4>
                        </th>

                    </tr>
                </table>
            </div>
            <div class="bd_ct_news_title">
                <h3>{{contens.text}}</h3>
                <!-- input ẩn lưu ảnh -->
                <input type="hidden" class="image_src_input" value='{{contens.image}}'>
                <!-- ảnh hiển thị -->
                <img class="image_src_img" alt="ảnh news">
            </div>
            <div class="bd_ct_news_commend">
                <div id="bd_ct_news_commend_thongKe_news1" style="display: flex;">

                    <img src="" alt="icon tim">
                    <p id="bd_ct_news_cmd_tk_text_news1" value="230">230 người khác</p>
                </div>
                <div class="bd_ct_news_commend_tuongTac">
                    <button id="bd_ct_news_cmd_tuongTac_like_news1" onclick="like('news1')">thích</button>
                    <button onclick="binhLuan()">Bình luận</button>
                    <button onclick="chiaSe()">chia sẻ</button>
                    <iframe id="bodyright_mesifP"></iframe>

                    <div class="bd_ct_news_cmd_tuongTac_pop">
                        <button onclick="closeNewPage()">Đóng</button>
                        <iframe id="bd_ct_news_cmd_tuongTac_ifP"></iframe>
                    </div>

                </div>

            </div>
        </div>
        {{/each}}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('input.image_src_input').forEach(hiddenInput => {
                try {
                    let data = hiddenInput.value;
                    if (typeof data === 'string') {
                        try {
                            data = JSON.parse(data); // parse lần 1
                            if (typeof data === 'string') {
                                data = JSON.parse(data); // parse lần 2 nếu vẫn là string
                            }
                        } catch (e) {
                            console.error("Không parse được ảnh:", e);
                            return;
                        }
                    }

                    let imgElement = hiddenInput.parentElement.querySelector('img.image_src_img');
                    if (imgElement && data.mimeType && data.base64) {
                        imgElement.src = `data:${data.mimeType};base64,${data.base64}`;
                    }
                } catch (e) {
                    console.error("Lỗi xử lý ảnh:", e);
                }
            });
        });
    </script>
</body>

</html>