<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="profile.css">
    <style>

    </style>
</head>

<body>
    <div class="head">
        <img src="./img/result_Inked481989551_1206891038111236_4687012339497917974_n_LI.jpg" alt="ảnh thumbnai">

        <table>
            <tr>
                <th>
                    <table>

                        <th style="width: 10%;">

                            <img src="./img/426309418_1440256106901425_3011488708200489727_n.jpg" alt="avt">

                        </th>
                        <th style="width: 90%;">
                            <h3>Hoàng Nguyễn</h3>
                            <h4>Yêu code</h4>
                            <h4>wtf</h4>
                        </th>

                    </table>
                </th>
                <th>
                    <div id="head_button">
                        <button>chỉnh sửa trang cá nhân</button>
                    </div>
                </th>
            </tr>
        </table>




    </div>

    <div class="body">
        <div id="think">
            <textarea placeholder="Bạn đang nghĩ gì?"></textarea>
            <button>Tạo tin</button>
        </div>
        <div class="news">
            <!-- giao diện ô phải làm giống facebook có like, commend, share -->
            <div class="bd_ct_news_nguoiDang" style="">
                <table>

                    <tr>
                        <th> <img style="width: 50px;height: 50px;" src="./img/avt1.jpg" alt="ảnh con"></th>
                        <th>
                            <h3>Schanel</h3>
                        </th>
                        <th></th>
                    </tr>

                    <tr>
                        <th></th>
                        <th>
                            <h4>24 Tháng 4, 2024</h4>
                        </th>

                    </tr>
                </table>
            </div>
            <div class="bd_ct_news_title">
                <h3>Chân thành cảm ơn cha đẻ của UNIKEY</h3>
                <img src="./img/conten1.jpg" alt="ảnh news">
            </div>
            <div class="bd_ct_news_commend">
                <div id="bd_ct_news_commend_thongKe_news1" style="display: flex;">

                    <img src="" alt="icon tim">
                    <p id="bd_ct_news_cmd_tk_text_news1" value="230">230 người khác</p>
                </div>
                <div class="bd_ct_news_commend_tuongTac">
                    <button id="bd_ct_news_cmd_tuongTac_like_news1" onclick="like('news1')">thích</button>
                    <button onclick="binhLuan()">Bình luận</button>
                    <button onclick="chiaSe()">chia sẻ</button>
                    <iframe id="bodyright_mesifP"></iframe>

                    <div class="bd_ct_news_cmd_tuongTac_pop">
                        <button onclick="closeNewPage()">Đóng</button>
                        <iframe id="bd_ct_news_cmd_tuongTac_ifP"></iframe>
                    </div>


                </div>

            </div>
        </div>
        <div class="news">
            <!-- giao diện ô phải làm giống facebook có like, commend, share -->
            <div class="bd_ct_news_nguoiDang" style="">
                <table>

                    <tr>
                        <th> <img style="width: 50px;height: 50px;" src="./img/avt4.jpg" alt="ảnh con"></th>
                        <th>
                            <h3>Tào Phớ đây</h3>
                        </th>
                        <th></th>
                    </tr>

                    <tr>
                        <th></th>
                        <th>
                            <h4>24 Tháng 4, 2024</h4>
                        </th>

                    </tr>
                </table>
            </div>
            <div class="bd_ct_news_title">
                <h3>Làm tý git gì chưa người đẹp</h3>
                <img src="./img/github logic.png" alt="ảnh news">
            </div>
            <div class="bd_ct_news_commend">
                <div id="bd_ct_news_commend_thongKe_news2" style="display: flex;">

                    <img src="" alt="icon tim">
                    <p id="bd_ct_news_cmd_tk_text_news2" value="230">230 người khác</p>
                </div>
                <div class="bd_ct_news_commend_tuongTac">
                    <button id="bd_ct_news_cmd_tuongTac_like_news2" onclick="like('news2')">thích</button>
                    <button onclick="binhLuan()">Bình luận</button>
                    <button onclick="chiaSe()">chia sẻ</button>
                    <iframe id="bodyright_mesifP"></iframe>




                </div>

            </div>
        </div>

    </div>
    <script>
        function binhLuan() {
            document.getElementsByTagName("BODY")[0].classList.add("nenMo");
            let popup = document.querySelector(".bd_ct_news_cmd_tuongTac_pop");
            popup.style.display = "block";
            document.getElementById("bd_ct_news_cmd_tuongTac_ifP").src = "binhluan.html";

        }
        function chiaSe() {
            document.getElementsByTagName("BODY")[0].classList.add("nenMo");
            let popup = document.querySelector(".bd_ct_news_cmd_tuongTac_pop");
            popup.style.display = "block";
            document.getElementById("bd_ct_news_cmd_tuongTac_ifP").src = "chiase.html";
        }
        let dem = 0;
        let check = false;
        function like(id) {
            // Biến đếm phải được đặt bên ngoài để giữ trạng thái
            // Biến trạng thái cũng cần được đặt bên ngoài
            let text = "bd_ct_news_cmd_tk_text" + "_" + id;
            console.log(text);
            id = "bd_ct_news_cmd_tuongTac_like" + "_" + id;
            let button = document.getElementById(id);


            let thongKeText = document.getElementById(text);


            dem++;
            check = dem % 2 !== 0;

            if (check) {
                button.style.backgroundColor = "blue";
                thongKeText.innerText = `Bạn và ${parseInt(thongKeText.getAttribute("value")) + 1} người khác thích`;
            } else {
                button.style.backgroundColor = ""; // Reset màu mặc định
                thongKeText.innerText = `${thongKeText.getAttribute("value")} người thích`; // Chỉ hiển thị số người thích
            }

        }
        function closeNewPage() {
            let popup = document.querySelector(".bd_ct_news_cmd_tuongTac_pop");
            popup.style.display = "none";
            document.getElementsByTagName("BODY")[0].classList.remove("nenMo");
        }

    </script>
</body>

</html>