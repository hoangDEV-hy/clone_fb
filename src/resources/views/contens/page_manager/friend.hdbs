<div style="display: flex;">
    <div>
        <div>
            <a href="/page_manager/friends/joined"> đã kết bạn</a>
        </div>
        <div>
            <a href="/page_manager/friends/waited"> đang chờ duyệt</a>
        </div>
    </div>
    <div>
        {{#if group.length}}
        {{#each group}}
        <div class="the card">
            <span data-id="{{this.id}}" style="display: none;"></span>
            <img src="" alt="">
            <input type="text" name="name" value="{{this.name}}" readonly>

            <div style="display: flex;">
                <button>Add</button>
                <div name="more" style="visibility: hidden;">
                    <a href="">View profile</a>
                    <a href="">Remove friend</a>
                </div>
            </div>
        </div>
        {{/each}}
        {{else}}
        <h1>No friend requests</h1>
        {{/if}}
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let button = document.getElementsByTagName("button")[0];
        let moreElement = document.getElementsByName('more')[0];

        button.addEventListener("click", function () {
            if (moreElement.style.visibility === 'visible') {
                moreElement.style.visibility = 'hidden';
            } else {
                moreElement.style.visibility = 'visible';
            }
        });
    });
</script>