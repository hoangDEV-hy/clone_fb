<body>

    <div data-role="textBox">
        <input type="text" name="name">
    </div>

    <div data-role="tableValue">
        <table border="1">
            <tr>
                <th>Avatar</th>
                <th>Name</th>
                <th>Action</th>
            </tr>
        </table>
    </div>

    <script>
        let input = document.querySelector('[data-role="textBox"] input');
        let inputBox = document.querySelector('[data-role="textBox"]');
        let data = undefined;

        // Nhận dữ liệu từ iframe
        window.addEventListener('message', event => {
            if (event.origin !== window.location.origin) return;
            window.lastChatRoomUser = event.data;
            console.log('Đã nhận được data từ iframe');
        });

        let timer = null;

        // Gửi request tìm kiếm
        async function send_searchResult() {
            const text = input.value.trim();
            if (text === "") return;

            data = window.lastChatRoomUser;
            if (!data) {
                console.log("⚠ Chưa nhận được postMessage từ iframe → chưa submit");
                return;
            }

            const params = new URLSearchParams({
                idUser: data.idUser,
                chat_roomId: data.chat_roomId,
                name: text
            });

            let search_values = await fetch('/mess/search?' + params);
            search_values = await search_values.json();

            let table = document.querySelector('[data-role="tableValue"] table');
            table.innerHTML = `
                <tr>
                    <th>Avatar</th>
                    <th>Name</th>
                    <th>Action</th>
                </tr>
            `;

            handle_searchValues(search_values.friendList);
        }

        // Delay khi nhập
        input.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(send_searchResult, 1000);
        });

        // Click ra ngoài → chạy tìm kiếm
        document.addEventListener('click', (e) => {
            try {

                if (!inputBox.contains(e.target)) {
                    clearTimeout(timer);
                    send_searchResult();
                }
            } catch (err) {
                console.log("lỗi trong xử lý client", err);
                alert('thêm thành viên không thành công');
            }
        });

        // Thêm user vào phòng
        async function addTo_room(userId) {
            const chat_memberValue = {
                chat_id: data.chat_roomId,
                idUser: userId,
                status: 'pending'
            };

            const notification_value = {
                selectedIdChatRoom: data.chat_roomId,
                selectedSenderId: data.idUser,
                receiver_id: userId,
                content: `Invite to chat room of ${data.idUser}`
            };

            try {
                // Gửi request tạo notification
                const response_add_notification = await fetch('/notification/chat_members', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ notification_value })
                });

                // Kiểm tra lỗi HTTP
                if (!response_add_notification.ok) {
                    const errorBody = await response_add_notification.text();
                    console.error("❌ Lỗi khi tạo notification:", errorBody);
                    throw new Error("Không thể tạo notification");
                }
                else {
                    alert("thành công")
                }

                // Gửi request thêm chat member
                const response_add_chat_member = await fetch('/mess/chat_room/people', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ chat_memberValue })
                });

                if (!response_add_chat_member.ok) {
                    const errorBody = await response_add_chat_member.text();
                    console.error("❌ Lỗi khi thêm người vào phòng:", errorBody);
                    throw new Error("Không thể thêm người vào chat room");
                }

                const chatMemberJson = await response_add_chat_member.json();
                console.log('👥 Add chat member response:', chatMemberJson);

            } catch (err) {
                console.error("🔥 Lỗi trong addTo_room:", err);

                // Tùy bạn xử lý UI
                alert("Có lỗi xảy ra khi gửi lời mời vào phòng chat.");
            }
        }


        // Render danh sách
        function handle_searchValues(list) {
            let table = document.querySelector('[data-role="tableValue"] table');

            if (!list || list.length === 0) {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td colspan="3" style="text-align:center">No data</td>
                `;
                table.appendChild(tr);
                return;
            }

            list.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        ${item.avatar ? `<img src="/${item.avatar}" width="40" height="40">` : ''}
                    </td>
                    <td>
                        <a href="/mess/search/profileUser?userId=${item.id}">
                            ${item.name || ''}
                        </a>
                    </td>
                    <td>
                        <button onclick="addTo_room('${item.id}')">Add to room</button>
                    </td>
                `;
                table.appendChild(tr);
            });
        }
    </script>

</body>