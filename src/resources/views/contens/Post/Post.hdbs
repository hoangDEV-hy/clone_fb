<form action="">
    <div>
        <div style="display:flex">
            <input type="hidden" id="PostId" value="{{Post.id}}">
            {{!-- for update --}}
            <input type="hidden" id="groupId" value="{{group_id}}{{Post.group_id}}">
            <input type="hidden" id="userId" value="{{user.id}}{{Post.user_id}}">
            {{#if user.id}}
            <img src="{{user.avatar}}" alt="" style="width:50px;height:50px;border-radius:50%;">
            <h3>{{user.name}}</h3>
            {{/if}}
            {{#if Post.user_id}}
            <img src="{{Post.users.avatar}}" alt="" style="width:50px;height:50px;border-radius:50%;">
            <h3>{{Post.users.name}}</h3>
            {{/if}}
            <select id="scope">
                <option value="">-- Chọn phạm vi truy cập --</option>
                <option value="only_me">only_me</option>
                <option value="public">public</option>
                <option value="group">group</option>
            </select>
        </div>

        <!-- Khung chứa background + textarea -->
        <div style="position: relative; width: 300px; height: 200px;">

            <img name="background" src="" alt=""
                style="position: absolute; z-index: 1; width: 100%; height: 100%; object-fit: cover;">
            <input name="dataImage" type="hidden" value={{Post.contens.image}}>
            <textarea name="contens" id="contens"
                style="position: absolute; z-index: 2; width: 100%; height: 100%; background: transparent; resize: none; font-size: 16px; color: black;">{{Post.contens.text}}</textarea>
        </div>

        <!-- Select background -->
        <div>
            <select id="ground">
                <option value="">-- Chọn Picture --</option>
                <option value="/pictures/avatar.jpg">img 1</option>
                <option value="/pictures/image-1754515454077-261962452.png">img 2</option>
                <option value="/pictures/image-1754516183050-615377140.png">img 3</option>
            </select>

            <!-- Select emoji -->
            <select id="emoji">
                <option value="">-- Chọn emoji --</option>
                <option value="👍">👍</option>
                <option value="😀">😀</option>
                <option value="😢">😢</option>
                <option value="😂">😂</option>
                <a href="">upload pictures</a>

            </select>
            <input type="file" id="fileInput" accept="image/*">
            <button id="upload">upload</button>
        </div>

        <!-- Submit -->
        <div>
            <button id="submit">Submit</button>
        </div>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        let ground = document.getElementById('ground');
        let backgrounds = document.querySelector('img[name="background"]');
        let text = document.getElementById('contens');
        let emoji = document.getElementById('emoji');
        let data = document.querySelector('input[name="dataImage"]');
        if (!data == null) {

            let imgData = JSON.parse(data.value);
            while (typeof imgData === 'string') {
                imgData = JSON.parse(imgData);
            }
            backgrounds.src = `data:${imgData.mimeType};base64,${imgData.base64}`;
        }
        // Đổi background
        ground.onchange = function () {
            backgrounds.src = this.value;
        };

        // Chèn emoji vào textarea
        emoji.onchange = function () {
            if (this.value) {
                text.value += this.value;
                this.value = ""; // reset select về mặc định
            }
        };

        //upload
        document.getElementById('upload').addEventListener('click', async (e) => {
            e.preventDefault();

            const fileInput = document.getElementById('fileInput');
            if (!fileInput.files.length) {
                alert('Chọn file trước!');
                return;
            }

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            const res = await fetch('http://localhost:3000/Posts/upload', {
                method: 'Post',
                body: formData
            });

            const data = await res.json();
            backgrounds.src = `data:${data.mimeType};base64,${data.base64}`;
        });
        async function getBase64FromUrl(url) {
            const response = await fetch(url);
            const blob = await response.blob();
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onloadend = () => resolve(reader.result); // trả về data URL base64
                reader.onerror = reject;
                reader.readAsDataURL(blob);
            });
        }

        document.getElementById('submit').addEventListener('click', async (e) => {
            e.preventDefault();
            //image
            const url = backgrounds.src;
            let dataUrl = url;
            if (!url.startsWith('data:')) {
                // nếu là url bình thường thì fetch và chuyển thành base64
                dataUrl = await getBase64FromUrl(url);
            }

            const base64 = dataUrl.split(',')[1];
            const mimeType = dataUrl.match(/^data:(.*);base64/)?.[1] || "";[1] || "";
            //conten
            const content = {
                text: text.value,
                image: {
                    mimeType: mimeType, // Lấy mimeType
                    base64: base64
                }
            }



            const formData = new FormData();
            formData.append('PostId_curtain', document.getElementById('PostId').value)
            formData.append('userId', document.getElementById('userId').value);
            let group_id = document.getElementById('groupId').value;
            let scope = document.getElementById('scope').value;
            if (scope === '') scope = 'only_me';
            formData.append('groupId', group_id);
            formData.append('scope', scope);

            formData.append('content', JSON.stringify(content));

            fetch('http://localhost:3000/Posts/save', {
                method: 'POST',
                body: formData
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 'ok') {
                        // Cách 1: quay lại trang trước
                        window.history.back();

                        // Cách 2 (nếu muốn chỉ rõ trang)
                        // window.location.href = '/Posts';
                    } else {
                        alert('Lưu thất bại');
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Có lỗi xảy ra');
                });
        })

    });
</script>