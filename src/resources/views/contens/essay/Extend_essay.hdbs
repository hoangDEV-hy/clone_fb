<form action="">
    <div>
        <div style="display:flex">
            {{#if essay.essayId_origin}}
            <input type="hidden" id="essayId_original" value="{{essay.essayId_origin}}">
            <input type="hidden" id="essayId_curtain" value="{{essay.id}}">
            {{else}}
            <input type="hidden" id="essayId_original" value="{{essay.id}}">
            <input type="hidden" id="essayId_curtain" value="">
            {{/if}}
            {{!-- for update --}}
            <input type="hidden" id="groupId" value="{{group_id}}{{essay.group_id}}">
            <input type="hidden" id="userId" value="{{user.id}}{{essay.user_id}}">

            <img src="/{{user.avatar}}{{essay.users.avatar}}" alt="" style="width:50px;height:50px;border-radius:50%;">
            <h3>{{user.name}}{{essay.users.name}}</h3>




            <select id="scope">
                <option value="">-- Chọn phạm vi truy cập --</option>
                <option value="only_me">only_me</option>
                <option value="public">public</option>
                <option value="group">group</option>
            </select>
        </div>

        <!-- Khung chứa background + textarea -->
        <div style="position: relative; width: 300px; height: 200px;">
            <textarea name="contens" id="contens" placeholder="vui long nhap noi dung">{{essay.think}}</textarea>
            <div>
                <img name="background" src="" alt=""
                    style="position: absolute; z-index: 1; width: 100%; height: 100%; object-fit: cover;">
                <input name="dataImage" type="hidden"
                    value='{{#if conten.image}}{{conten.image}}{{else}}{{{essay.contens.image}}}{{/if}}'>
                <textarea name="text" id="text"
                    style="position: absolute; z-index: 2; width: 100%; height: 100%; background: transparent; resize: none; font-size: 16px; color: black;">{{conten.text}}{{essay.contens.text}}</textarea>
            </div>
        </div>

        <!-- Select background -->
        <div>


            <!-- Select emoji -->
            <select id="emoji">
                <option value="">-- Chọn emoji --</option>
                <option value="👍">👍</option>
                <option value="😀">😀</option>
                <option value="😢">😢</option>
                <option value="😂">😂</option>
                <a href="">upload pictures</a>

            </select>

        </div>

        <!-- Submit -->
        <div>
            <button id="submit">Submit</button>
        </div>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        let data = document.querySelector('input[name="dataImage"]');
        let text = document.getElementById('text');
        let contens = document.getElementById('contens');
        let emoji = document.getElementById('emoji');
        let imgData = JSON.parse(data.value);
        while (typeof imgData === "string") imgData = JSON.parse(imgData);
        console.log(JSON.stringify(imgData))
        let backgrounds = document.querySelector('img[name="background"]');
        backgrounds.src = `data:${imgData.mimeType};base64,${imgData.base64}`;
        // Chèn emoji vào textarea
        emoji.onchange = function () {
            if (this.value) {
                contens.value += this.value;
                this.value = ""; // reset select về mặc định
            }
        };


        document.getElementById('submit').addEventListener('click', async (e) => {
            e.preventDefault();
            //conten
            const conten = {
                text: text.value,
                image: data.value

            }
            console.log('id', document.getElementById('essayId_curtain').value)


            const formData = new FormData();
            formData.append('essayId_original', document.getElementById('essayId_original').value)
            formData.append('essayId_curtain', document.getElementById('essayId_curtain').value)
            formData.append('userId', document.getElementById('userId').value);
            formData.append('groupId', document.getElementById('groupId').value);
            let scope = document.getElementById('scope').value;
            if (scope === '') scope = 'only_me';
            formData.append('scope', scope);
            formData.append('conten', JSON.stringify(conten));
            formData.append('think', document.getElementById('contens').value);

            try {
                const res1 = await fetch('http://localhost:3000/essays/save', { method: 'post', body: formData });
                const res2 = await fetch('http://localhost:3000/essay/share/save', { method: 'post', body: formData });

                if (res1.ok && res2.ok) {
                    alert('Success');
                    window.history.back();
                } else {
                    alert('Lỗi khi lưu dữ liệu');
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi kết nối server');
            }
        })

    });
</script>